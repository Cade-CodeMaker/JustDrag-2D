# --- assets/ ----------------------------------------------------------------
# 素材一律不进仓库：立绘版权不属于本项目，regions.json 又是在 demo 里肉眼调出来的，
# 两者都只属于本地。产物更是随时能从它们重建。整棵子树忽略。
#
# 下面三条 negation 是为了让 README.md 里那张目录图在 git 里仍然成立：
# git 不会进入被排除的目录，所以每一层都要先把它自己救回来，才能救回里面的占位文件。
assets/**
!assets/README.md
!assets/*/
!assets/*/README.md
!assets/*/out/
!assets/*/out/.gitkeep

# Superseded pre-reorganisation build output, kept on disk for reference.
# Nothing reads it; tools/ is the pipeline now.
build/

__pycache__/
*.pyc

# --- app/ -------------------------------------------------------------------
# All three are installed or derived, never authored:
#   ort/      copied out of node_modules by scripts/sync-ort.mjs per install
#   models/   the 168MB isnet-anime.onnx, fetched once and cached locally
#   _ref/     fixtures dump_reference.py writes for the browser parity test
app/node_modules/
app/public/ort/
app/public/models/
app/public/_ref/

# The app build output is generated by `npm run build`.
app/dist/
